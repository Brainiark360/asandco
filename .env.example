# Optional for browsing the site; required to deliver real enquiries.
# Server-only HTTPS endpoint accepting the JSON payload documented in README.md.
CONTACT_WEBHOOK_URL=
# Optional bearer token for that endpoint. Never use a NEXT_PUBLIC_ prefix.
CONTACT_WEBHOOK_TOKEN=

# Optional Google Search Console HTML-tag verification value (not the full tag).
# This value is public by design; never put an account password or API key here.
GOOGLE_SITE_VERIFICATION=
# Optional: true keeps a non-Vercel staging production build out of search.
# Vercel previews/custom non-production environments and next dev are noindex automatically.
# Read at build time: rebuild after changes. Leave blank for the real production site.
SEO_NOINDEX=
